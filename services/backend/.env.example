PORT=8080
PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_SOCKET_URL=wss://api.example.com/ws
WECHAT_APPID=your-wechat-minigame-appid
WECHAT_SECRET=your-wechat-minigame-secret
APP_TOKEN_SECRET=replace-with-long-random-secret
SOCKET_TOKEN_SECRET=replace-with-another-long-random-secret
ADMIN_SESSION_SECRET=replace-with-long-random-admin-session-secret
ADMIN_SESSION_TTL_MS=43200000
# 仅当 adminUsers 为空时用于一次性初始化；已有管理员时请勿保留初始化密码。
INITIAL_ADMIN_USERNAME=replace-with-initial-admin-username
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-strong-password
DATABASE_DRIVER=mongodb
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=huapai
BACKEND_ALLOWED_ORIGINS=
BACKEND_DEV_OPENID=
